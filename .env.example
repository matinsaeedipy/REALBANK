# Copy these into your host's "Environment variables" panel (or a local .env you export yourself).
# All of them are optional except DJANGO_SECRET_KEY in production.

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

# Comma-separated hostnames. Default "*" (any host). Example: bank.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Only needed if you see "CSRF verification failed" behind a proxy. Example: https://bank.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# 1 = secure cookies (HTTPS sites, default in production). Set 0 only for plain-HTTP servers.
DJANGO_HTTPS=1

# 1 = redirect http -> https inside Django (only if your proxy sends X-Forwarded-Proto)
DJANGO_SSL_REDIRECT=0

# Create an admin user automatically on start (optional)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Where SQLite + the generated secret key live (default /app/data in Docker)
DATA_DIR=/app/data

# PostgreSQL instead of SQLite (also add psycopg[binary] to requirements.txt)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSLMODE=require

# Time zone used for dates (default Asia/Tehran)
# DJANGO_TIME_ZONE=Asia/Tehran
